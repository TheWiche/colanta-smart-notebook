# Tiendas: el documento publicado ENTERO (Archivo > Compartir > Publicar en la Web > Todo el documento > CSV), sin gid.
# La app lee todas sus hojas y cada hoja es una ruta: el nombre de la pestaña es el nombre de la ruta.
EXPO_PUBLIC_URL_TIENDAS=https://docs.google.com/spreadsheets/d/e/XXXX/pub?output=csv
# Productos: una sola hoja (con gid) con las columnas Código, Nombre del Producto (Catálogo), Alias y Estado de Coincidencia.
EXPO_PUBLIC_URL_PRODUCTOS=https://docs.google.com/spreadsheets/d/e/XXXX/pub?gid=1&single=true&output=csv
# Panel Web interactivo para la supervisora (checklist de auditoría y transcripción)
EXPO_PUBLIC_URL_SUPERVISOR_WEB=https://thewiche.github.io/colanta-smart-notebook/
